# Synthetic development only; bootstrap creates private transport credentials.
BROKER_CONFIG=.local/broker.json
BROKER_HOST=127.0.0.1
BROKER_PORT=3210
BROKER_ADMIN_PORT=3211
# If using a private TLS reverse proxy, add its exact hostname to this allowlist.
BROKER_ALLOWED_HOSTNAMES=127.0.0.1,localhost
# Persistent service: set a private PostgreSQL connection string.
# DATABASE_URL=postgresql://broker:password@127.0.0.1:5432/broker
# Without DATABASE_URL, startup requires BROKER_EPHEMERAL_SYNTHETIC=1.
# BROKER_EPHEMERAL_SYNTHETIC=1
# Separate trusted worker host is required before production use.
